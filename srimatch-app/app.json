{
  "expo": {
    "name": "SriMatch - Sri Lankan Matrimony",
    "slug": "srimatch-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "srimatchapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.srimatch.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "SriMatch requires camera access for HD video calling, profile verification, and photo uploads.",
        "NSMicrophoneUsageDescription": "SriMatch requires microphone access for voice and video calling.",
        "NSPhotoLibraryUsageDescription": "SriMatch requires photo library access to upload photos and bank transfer receipts."
      }
    },
    "android": {
      "package": "com.srimatch.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#3d1f12",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "usesCleartextTraffic": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3d1f12",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-image",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://api.sithum-dev.online/api/v1",
      "wsUrl": "wss://api.sithum-dev.online/api/ws-chat",
      "router": {},
      "eas": {
        "projectId": "ea5b8014-73c6-4700-ad99-26b71ba7d641"
      }
    }
  }
}
