# ============================================
# SRIMATCH ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env before starting Docker or deploying to production
# ============================================

# --------------------------------------------
# Deployment & Ports
# --------------------------------------------
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
FRONTEND_PORT=80
DB_PORT_FORWARD=5432
REDIS_PORT_FORWARD=6379

# --------------------------------------------
# Database (PostgreSQL 16)
# --------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=srimatch_db
DB_USERNAME=srimatch_user
DB_PASSWORD=YOUR_STRONG_POSTGRES_PASSWORD_HERE

# --------------------------------------------
# Redis Cache & Presence
# --------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_STRONG_REDIS_PASSWORD_HERE

# --------------------------------------------
# Security & Encryption (AES-256 & JWT)
# (Generate a 256-bit secure hex key: `openssl rand -hex 32`)
# --------------------------------------------
JWT_SECRET=YOUR_SECURE_256_BIT_JWT_SECRET_KEY_HERE
APP_ENCRYPTION_KEY=YOUR_SECURE_32_CHAR_ENCRYPTION_KEY_HERE
COOKIE_SECURE=true

# --------------------------------------------
# Initial Admin Credentials (Optional)
# --------------------------------------------
DEFAULT_ADMIN_EMAIL=admin@srimatch.lk
DEFAULT_ADMIN_PASSWORD=YOUR_SECURE_ADMIN_INITIAL_PASSWORD_HERE

# --------------------------------------------
# CORS Allowed Origins (Comma-separated)
# --------------------------------------------
CORS_ALLOWED_ORIGINS=https://srimatch.com,https://www.srimatch.com,https://api.srimatch.com

# --------------------------------------------
# Cloudflare R2 Object Storage (Recommended Primary Storage)
# --------------------------------------------
R2_ENABLED=true
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_CLOUDFLARE_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_CLOUDFLARE_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=srimatch-media
R2_PUBLIC_CUSTOM_DOMAIN=https://media.srimatch.lk

# --------------------------------------------
# Cloudinary (Fallback / Optional Media Storage)
# --------------------------------------------
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# --------------------------------------------
# Transactional Email (Brevo / SendGrid / SMTP)
# --------------------------------------------
BREVO_API_KEY=YOUR_BREVO_API_KEY
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey

# --------------------------------------------
# SMS & Phone Verification (Twilio)
# --------------------------------------------
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=YOUR_TWILIO_PHONE_NUMBER
TWILIO_MESSAGING_SID=YOUR_TWILIO_MESSAGING_SID

# --------------------------------------------
# Payment Gateway (PayHere)
# --------------------------------------------
PAYHERE_MERCHANT_ID=YOUR_PAYHERE_MERCHANT_ID
PAYHERE_SECRET=YOUR_PAYHERE_SECRET
PAYHERE_APP_URL=https://www.payhere.lk/pay/checkout
PAYHERE_RETURN_URL=https://srimatch.com/payment/return
PAYHERE_CANCEL_URL=https://srimatch.com/payment/cancel
PAYHERE_NOTIFY_URL=https://api.srimatch.com/api/payments/webhook/payhere

# --------------------------------------------
# Cloudflare Turnstile Captcha
# --------------------------------------------
CLOUDFLARE_TURNSTILE_ENABLED=false
CLOUDFLARE_TURNSTILE_SECRET_KEY=YOUR_CLOUDFLARE_TURNSTILE_SECRET_KEY

# --------------------------------------------
# Frontend (Next.js) Environment Variables
# --------------------------------------------
NEXT_PUBLIC_API_URL=https://api.srimatch.com
NEXT_PUBLIC_WS_URL=wss://api.srimatch.com/ws-chat
