# ==============================================================================
# SRIMATCH PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Domain: sithum-dev.online
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & PROFILES
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
DOMAIN_NAME=api.sithum-dev.online
ACME_EMAIL=your-email@example.com

# ------------------------------------------------------------------------------
# 2. DATABASE & REDIS
# ------------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=srimatch_db
DB_USERNAME=srimatch_user
# Generate with: openssl rand -base64 24
DB_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD

REDIS_HOST=redis
REDIS_PORT=6379
# Generate with: openssl rand -base64 24
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

# ------------------------------------------------------------------------------
# 3. SECURITY & ENCRYPTION KEYS (CRITICAL)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32 (64 characters hex)
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_KEY

# Generate with: openssl rand -hex 16 (32 characters minimum)
APP_ENCRYPTION_KEY=REPLACE_WITH_32_CHAR_AES_KEY

# Comma-separated allowed web origins
CORS_ALLOWED_ORIGINS=https://sithum-dev.online,https://www.sithum-dev.online

# ------------------------------------------------------------------------------
# 4. CLOUDFLARE R2 OBJECT STORAGE (PHOTOS & MEDIA)
# ------------------------------------------------------------------------------
R2_ENABLED=true
# Found in: Cloudflare Dashboard -> Overview -> Right Sidebar -> "Account ID"
R2_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID

# Found in: Cloudflare Dashboard -> R2 -> "Manage R2 API Tokens"
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=srimatch-media
R2_PUBLIC_CUSTOM_DOMAIN=https://media.sithum-dev.online

# ------------------------------------------------------------------------------
# 5. CLOUDFLARE TURNSTILE (BOT & BRUTE-FORCE PROTECTION)
# ------------------------------------------------------------------------------
# Set to 'true' once you create your Turnstile widget in Cloudflare
CLOUDFLARE_TURNSTILE_ENABLED=false
# Found in: Cloudflare Dashboard -> Turnstile -> Your Widget -> "Secret Key"
CLOUDFLARE_TURNSTILE_SECRET_KEY=REPLACE_WITH_TURNSTILE_SECRET_KEY

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL (BREVO / SENDGRID)
# ------------------------------------------------------------------------------
# Brevo (Recommended): Dashboard -> SMTP & API -> API Keys
BREVO_API_KEY=REPLACE_WITH_BREVO_API_KEY

# SendGrid (Alternative):
SENDGRID_API_KEY=

# ------------------------------------------------------------------------------
# 7. SMS OTP & PHONE VERIFICATION (TWILIO)
# ------------------------------------------------------------------------------
# Found in: Twilio Console
TWILIO_ACCOUNT_SID=REPLACE_WITH_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=REPLACE_WITH_TWILIO_PHONE_NUMBER

# ------------------------------------------------------------------------------
# 8. PAYMENT GATEWAY (PAYHERE SRI LANKA)
# ------------------------------------------------------------------------------
# Found in: PayHere Merchant Portal -> Settings -> Domains & Credentials
PAYHERE_MERCHANT_ID=REPLACE_WITH_PAYHERE_MERCHANT_ID
PAYHERE_SECRET=REPLACE_WITH_PAYHERE_SECRET
PAYHERE_APP_URL=https://www.payhere.lk/pay/checkout
PAYHERE_RETURN_URL=https://sithum-dev.online/payment/return
PAYHERE_CANCEL_URL=https://sithum-dev.online/payment/cancel
PAYHERE_NOTIFY_URL=https://api.sithum-dev.online/api/payments/webhook/payhere
